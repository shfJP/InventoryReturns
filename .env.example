# Database (PostgreSQL)
# In Coolify, create/attach a PostgreSQL database and paste its internal connection string here.
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/inventory_returns?schema=public"

# Pilot auth: comma-separated list of employee IDs that can act as managers
# In production, replace with SSO/Entra and resolve from token
MANAGER_EMPLOYEE_IDS=EMP001,EMP002

# Optional: comma-separated Entra security group object IDs allowed to see/use Admin actions.
# If unset, manager users retain admin access for pilot/backward compatibility.
# In Azure App Registration, enable Security Groups in Token configuration → Groups claim.
ADMIN_GROUP_IDS=

# Optional sync automation defaults. App settings can override these after first boot.
AUTO_SYNC_ON_STARTUP=false
SYNC_CRON_ENABLED=false
SYNC_CRON_ENTRA=true
SYNC_CRON_ENTRA_INTERVAL_MINUTES=720
SYNC_CRON_REFTAB=true
SYNC_CRON_REFTAB_INTERVAL_MINUTES=10
SYNC_CRON_NINJAONE=true
SYNC_CRON_NINJAONE_INTERVAL_MINUTES=10
GRAPH_REQUEST_TIMEOUT_MS=30000
REF_TAB_REQUEST_TIMEOUT_MS=30000
NINJAONE_REQUEST_TIMEOUT_MS=30000
# Production defaults: do not create sample users/equipment, and clean old demo rows if present.
AUTO_SEED_DEMO_DATA=false
CLEAN_DEMO_DATA_ON_STARTUP=true

# Current user override for pilot (no SSO): set to an employee ID to impersonate
# Leave empty in production when using real auth
CURRENT_USER_EMPLOYEE_ID=

# --- Azure AD / Microsoft Entra ID (SSO + user sync) ---
# Register app in Azure AD: https://portal.azure.com → App registrations
# Application permissions (for sync): User.Read.All, Directory.Read.All
# Delegated permissions (for SSO): openid, profile, email, User.Read
# Add redirect URI for local dev: http://localhost:3000/api/auth/callback/azure-ad
# Add redirect URI for production: https://returns.sevenhillsstaff.org/api/auth/callback/azure-ad
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# next-auth (required for SSO — generate with: openssl rand -base64 32)
# When all four Azure + NEXTAUTH_SECRET vars are set, SSO is active.
# When unset, the app falls back to pilot mode (CURRENT_USER_EMPLOYEE_ID).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Production:
# NEXTAUTH_URL=https://returns.sevenhillsstaff.org

# --- Reftab (https://www.reftab.com/api-docs) — equipment / assignments source ---
# Auth is HMAC (public + secret keys from Reftab: Settings → API Keys → Create API Key).
# Signing matches Reftab's documented flow: https://www.reftab.com/faq/postman-reftab-api
# Optional Node reference client: https://github.com/Reftab/ReftabNode
REF_TAB_API_URL=https://www.reftab.com/api
REF_TAB_API_PUBLIC_KEY=
REF_TAB_API_SECRET_KEY=
# Reftab sync defaults to checked-out assets + loanee lookup.
# Set to loans if your account exposes better checked-out assignment details from GET /loans.
REF_TAB_SYNC_SOURCE=assets
# How many assets/loans to request per sync page (1–5000). Reftab supports ?limit= on GET /assets and GET /loans
REF_TAB_ASSETS_LIMIT=500
# Asset fallback only: dot-path on each asset that identifies the assignee.
# Examples: loanee, loanee.email, customFieldId — inspect your GET /assets JSON from api-docs or Postman.
REF_TAB_ASSIGNEE_FIELD=loanee
# Dot-paths for display (defaults match common Reftab asset fields)
REF_TAB_ASSET_TAG_FIELD=id
REF_TAB_SERIAL_FIELD=serial
REF_TAB_MODEL_FIELD=title
# Optional owner-reconciliation write endpoints. Defaults target Reftab loan check-in and new loan creation.
REF_TAB_CHECKIN_ENDPOINT_TEMPLATE=loans/{loanId}/checkin
REF_TAB_CHECKOUT_ENDPOINT=loans
REF_TAB_CREATE_LOANEE_ENDPOINT=loanees
REF_TAB_CREATE_MISSING_LOANEES=false
# Checked before creating a loanee; comma-separated templates can use {email}, {employeeId}, or {uid}.
REF_TAB_LOANEE_LOOKUP_ENDPOINTS=loanees?email={email},loanees?search={email},loanees?q={email},loanees?uid={employeeId},loanees?search={employeeId},loanees?q={employeeId},users?email={email},users?search={email},users?q={email}
# Optional owner-reconciliation asset creation defaults for NinjaOne devices missing from Reftab.
REF_TAB_CREATE_ASSET_ENDPOINT=assets
# Fallback category id for new Reftab assets when it cannot be inferred from synced Reftab data.
REF_TAB_CREATE_ASSET_CATEGORY_ID=
# Optional explicit category ids for NinjaOne device names containing LT or TB.
REF_TAB_CREATE_ASSET_LAPTOP_CATEGORY_ID=
REF_TAB_CREATE_ASSET_TABLET_CATEGORY_ID=
# Default staging location id for new Reftab assets created from NinjaOne reconciliation.
REF_TAB_CREATE_ASSET_LOCATION_ID=67497

# Legacy only: Bearer token + GET .../assignments?employee_id= for a custom API gateway (not official Reftab)
# REF_TAB_API_KEY=

# --- NinjaOne (https://app.ninjarmm.com/apidocs/?links.active=core) — device telemetry source ---
# Create an API Services / client credentials app in NinjaOne with Monitoring scope.
# Token endpoint: /ws/oauth/token. Device endpoint: /api/v2/devices.
NINJAONE_BASE_URL=https://app.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
NINJAONE_SCOPE=monitoring
NINJAONE_PAGE_SIZE=500
# Reconciliation needs device details, custom fields, and last logged-on user beyond the bulk devices list.
NINJAONE_ENRICH_DEVICE_DETAILS=true
NINJAONE_ENRICH_CONCURRENCY=5

# --- Notifications (IT alerts) ---
# One of: email | teams | webhook
NOTIFICATION_PROVIDER=webhook
# For email: SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_TO=it@company.com
# For Teams: incoming webhook URL
TEAMS_WEBHOOK_URL=
# For webhook: generic POST URL (e.g. n8n)
WEBHOOK_URL=

# Optional: base URL of this app (for links in notifications)
APP_BASE_URL=http://localhost:3000
# Production:
# APP_BASE_URL=https://returns.sevenhillsstaff.org
